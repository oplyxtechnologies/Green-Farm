# Green Nepal Krishi Farm - Environment Variables
# Copy this file to .env.local in apps/web and apps/admin, or at monorepo root.

# Supabase Configuration
# Obtain these from your Supabase Dashboard: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Optional: Supabase Service Role Key (Used only in server-side administrative contexts, NEVER expose in browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Site URLs
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Pexels API (Images & Video Engine)
PEXELS_API_KEY=your-pexels-api-key
NEXT_PUBLIC_PEXELS_API_KEY=your-pexels-api-key

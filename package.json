{
  "name": "green-nepal-krishi-farm-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "description": "Monorepo for Green Nepal Agricultural Farm commercial agriculture platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@green-farm/web",
    "dev:admin": "turbo run dev --filter=@green-farm/admin",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.1.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
